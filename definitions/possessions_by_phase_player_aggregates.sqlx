config {
    type: "table",
    schema: "dynamic_events_ip",
    name: "possessions_by_phase_player_aggregates",
    description: "Possession player aggregates split by phase",
    bigquery: {
        clusterBy: ["player_id", "team_id", "competition_edition_id"]
    },
    assertions:{
        nonNull: ["player_id", "team_id", "competition_edition_id"]
    }
}

SELECT 
de.player_id,
CONCAT(players.first_name, ' ', players.last_name) AS player_name,
players.short_name AS player_short_name,
phys.team_id,
teams.name AS team_name,
phys.competition_edition_id,
ce.name AS competition_edition_name,
phys.competition_id,
phys.competition_name,
phys.season_id,
phys.season_name,
phys.position_group AS player_role_position_group,
AVG(phys.minutes_full_all) AS avg_minutes_played,
AVG(phys.minutes_full_tip) AS avg_minutes_played_tip,
COUNT(*) AS count_match,

(SUM(de.count_all_possessions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_all_possessions_per_30_tip,
(SUM(de.count_one_touch_passes_all_possessions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_one_touch_passes_all_possessions_per_30_tip,
(SUM(de.quick_passes_all_possessions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_quick_passes_all_possessions_per_30_tip,
(SUM(de.received_in_tight_space_all_possessions) / NULLIF(SUM(de.count_all_possessions), 0)) * 100 AS percentage_all_possessions_in_low_separation_start,
(SUM(de.received_in_open_space_all_possessions) / NULLIF(SUM(de.count_all_possessions), 0)) * 100 AS percentage_all_possessions_in_high_separation_start,
(SUM(de.8m_carry_all_possessions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_carries_all_possessions_per_30_tip,
(SUM(de.8m_carry_at_speed_all_possessions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_all_possessions_carries_above_running_speed_per_30_tip,
(SUM(de.forward_momentum_all_possessions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_forward_momentum_all_possessions_per_30_tip,

(SUM(de.count_possessions_in_build_up) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_possessions_in_build_up_per_30_tip,
(SUM(de.count_one_touch_passes_possessions_in_build_up) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_one_touch_passes_possessions_in_build_up_per_30_tip,
(SUM(de.quick_passes_possessions_in_build_up) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_quick_passes_possessions_in_build_up_per_30_tip,
(SUM(de.received_in_tight_space_possessions_in_build_up) / NULLIF(SUM(de.count_possessions_in_build_up), 0)) * 100 AS percentage_possessions_in_build_up_in_low_separation_start,
(SUM(de.received_in_open_space_possessions_in_build_up) / NULLIF(SUM(de.count_possessions_in_build_up), 0)) * 100 AS percentage_possessions_in_build_up_in_high_separation_start,
(SUM(de.8m_carry_possessions_in_build_up) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_carries_possessions_in_build_up_per_30_tip,
(SUM(de.8m_carry_at_speed_possessions_in_build_up) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_possessions_in_build_up_carries_above_running_speed_per_30_tip,
(SUM(de.forward_momentum_possessions_in_build_up) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_forward_momentum_possessions_in_build_up_per_30_tip,

(SUM(de.count_possessions_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_possessions_in_create_per_30_tip,
(SUM(de.count_one_touch_passes_possessions_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_one_touch_passes_possessions_in_create_per_30_tip,
(SUM(de.quick_passes_possessions_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_quick_passes_possessions_in_create_per_30_tip,
(SUM(de.received_in_tight_space_possessions_in_create) / NULLIF(SUM(de.count_possessions_in_create), 0)) * 100 AS percentage_possessions_in_create_in_low_separation_start,
(SUM(de.received_in_open_space_possessions_in_create) / NULLIF(SUM(de.count_possessions_in_create), 0)) * 100 AS percentage_possessions_in_create_in_high_separation_start,
(SUM(de.8m_carry_possessions_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_carries_possessions_in_create_per_30_tip,
(SUM(de.8m_carry_at_speed_possessions_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_possessions_in_create_carries_above_running_speed_per_30_tip,
(SUM(de.forward_momentum_possessions_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_forward_momentum_possessions_in_create_per_30_tip,

(SUM(de.count_possessions_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_possessions_in_finish_per_30_tip,
(SUM(de.count_one_touch_passes_possessions_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_one_touch_passes_possessions_in_finish_per_30_tip,
(SUM(de.quick_passes_possessions_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_quick_passes_possessions_in_finish_per_30_tip,
(SUM(de.received_in_tight_space_possessions_in_finish) / NULLIF(SUM(de.count_possessions_in_finish), 0)) * 100 AS percentage_possessions_in_finish_in_low_separation_start,
(SUM(de.received_in_open_space_possessions_in_finish) / NULLIF(SUM(de.count_possessions_in_finish), 0)) * 100 AS percentage_possessions_in_finish_in_high_separation_start,
(SUM(de.8m_carry_possessions_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_carries_possessions_in_finish_per_30_tip,
(SUM(de.8m_carry_at_speed_possessions_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_possessions_in_finish_carries_above_running_speed_per_30_tip,
(SUM(de.forward_momentum_possessions_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_forward_momentum_possessions_in_finish_per_30_tip,

(SUM(de.count_possessions_in_transition) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_possessions_in_transition_per_30_tip,
(SUM(de.count_one_touch_passes_possessions_in_transition) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_one_touch_passes_possessions_in_transition_per_30_tip,
(SUM(de.quick_passes_possessions_in_transition) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_quick_passes_possessions_in_transition_per_30_tip,
(SUM(de.received_in_tight_space_possessions_in_transition) / NULLIF(SUM(de.count_possessions_in_transition), 0)) * 100 AS percentage_possessions_in_transition_in_low_separation_start,
(SUM(de.received_in_open_space_possessions_in_transition) / NULLIF(SUM(de.count_possessions_in_transition), 0)) * 100 AS percentage_possessions_in_transition_in_high_separation_start,
(SUM(de.8m_carry_possessions_in_transition) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_carries_possessions_in_transition_per_30_tip,
(SUM(de.8m_carry_at_speed_possessions_in_transition) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_possessions_in_transition_carries_above_running_speed_per_30_tip,
(SUM(de.forward_momentum_possessions_in_transition) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_forward_momentum_possessions_in_transition_per_30_tip,

(SUM(de.count_possession_retentions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_possession_retentions_per_30_tip,
(SUM(de.count_one_touch_passes_possession_retentions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_one_touch_passes_possession_retentions_per_30_tip,
(SUM(de.quick_passes_possession_retentions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_quick_passes_possession_retentions_per_30_tip,
(SUM(de.received_in_tight_space_possession_retentions) / NULLIF(SUM(de.count_possession_retentions), 0)) * 100 AS percentage_possession_retentions_in_low_separation_start,
(SUM(de.received_in_open_space_possession_retentions) / NULLIF(SUM(de.count_possession_retentions), 0)) * 100 AS percentage_possession_retentions_in_high_separation_start,
(SUM(de.8m_carry_possession_retentions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_carries_possession_retentions_per_30_tip,
(SUM(de.8m_carry_at_speed_possession_retentions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_8m_possession_retentions_carries_above_running_speed_per_30_tip,
(SUM(de.forward_momentum_possession_retentions) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_forward_momentum_possession_retentions_per_30_tip,

FROM 
  ${ref("dynamic_events_ip", "possessions")} AS de
JOIN
  ${ref("physical_data", "physical_data")}  AS phys
ON
  de.player_id = phys.player_id
  AND de.match_id = phys.match_id
JOIN
  ${ref("metadata", "players")} AS players
ON
  de.player_id = players.id
JOIN
  ${ref("metadata", "teams")} AS teams
ON
  phys.team_id = CAST(teams.id AS INT)
JOIN
  ${ref("metadata", "match_metadata")} AS match 
ON
  de.match_id = match.match_id
JOIN
  ${ref("metadata", "competition_editions")} AS ce
ON
   ce.id = phys.competition_edition_id
WHERE
  phys.minutes_full_all >= 60
GROUP BY
  de.player_id,
  phys.team_id,
  phys.competition_edition_id,
  competition_edition_name,
  phys.competition_id,
  phys.competition_name,
  phys.season_id,
  phys.season_name,
  phys.position_group,
  players.first_name,
  players.last_name,
  players.short_name,
  teams.name