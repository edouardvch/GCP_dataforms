  (SUM(de.count_around_second_last_line_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_around_second_last_line_in_create_per_30_tip,
  (SUM(de.count_targeted_around_second_last_line_in_create) / NULLIF(SUM(de.count_around_second_last_line_in_create), 0)) * 100 AS percentage_around_second_last_line_in_create_targeted,
  (SUM(de.count_received_around_second_last_line_in_create) / NULLIF(SUM(de.count_targeted_around_second_last_line_in_create), 0)) * 100 AS percentage_around_second_last_line_in_create_received,
  (SUM(de.xthreat_around_second_last_line_in_create) / NULLIF(SUM(de.count_around_second_last_line_in_create), 0)) AS avg_xthreat_per_around_second_last_line_in_create,
  (SUM(de.xpass_completion_around_second_last_line_in_create) / NULLIF(SUM(de.count_around_second_last_line_in_create), 0)) AS avg_xpass_completion_around_second_last_line_in_create,
  (SUM(de.count_dangerous_around_second_last_line_in_create) / NULLIF(SUM(de.count_around_second_last_line_in_create), 0)) * 100 AS percentage_around_second_last_line_in_create_dangerous,
  (SUM(de.count_difficult_around_second_last_line_in_create) / NULLIF(SUM(de.count_around_second_last_line_in_create), 0)) * 100 AS percentage_around_second_last_line_in_create_difficult_target,



  (SUM(de.count_around_second_last_line_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_around_second_last_line_in_finish_per_30_tip,
  (SUM(de.count_targeted_around_second_last_line_in_finish) / NULLIF(SUM(de.count_around_second_last_line_in_finish), 0)) * 100 AS percentage_around_second_last_line_in_finish_targeted,
  (SUM(de.count_received_around_second_last_line_in_finish) / NULLIF(SUM(de.count_targeted_around_second_last_line_in_finish), 0)) * 100 AS percentage_around_second_last_line_in_finish_received,
  (SUM(de.xthreat_around_second_last_line_in_finish) / NULLIF(SUM(de.count_around_second_last_line_in_finish), 0)) AS avg_xthreat_per_around_second_last_line_in_finish,
  (SUM(de.xpass_completion_around_second_last_line_in_finish) / NULLIF(SUM(de.count_around_second_last_line_in_finish), 0)) AS avg_xpass_completion_around_second_last_line_in_finish,
  (SUM(de.count_dangerous_around_second_last_line_in_finish) / NULLIF(SUM(de.count_around_second_last_line_in_finish), 0)) * 100 AS percentage_around_second_last_line_in_finish_dangerous,
  (SUM(de.count_difficult_around_second_last_line_in_finish) / NULLIF(SUM(de.count_around_second_last_line_in_finish), 0)) * 100 AS percentage_around_second_last_line_in_finish_difficult_target,



  (SUM(de.count_through_last_line) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_through_last_line_per_30_tip,
  (SUM(de.count_targeted_through_last_line) / NULLIF(SUM(de.count_through_last_line), 0)) * 100 AS percentage_through_last_line_targeted,
  (SUM(de.count_received_through_last_line) / NULLIF(SUM(de.count_targeted_through_last_line), 0)) * 100 AS percentage_through_last_line_received,
  (SUM(de.xthreat_through_last_line) / NULLIF(SUM(de.count_through_last_line), 0)) AS avg_xthreat_per_through_last_line,
  (SUM(de.xpass_completion_through_last_line) / NULLIF(SUM(de.count_through_last_line), 0)) AS avg_xpass_completion_through_last_line,
  (SUM(de.count_dangerous_through_last_line) / NULLIF(SUM(de.count_through_last_line), 0)) * 100 AS percentage_through_last_line_dangerous,
  (SUM(de.count_difficult_through_last_line) / NULLIF(SUM(de.count_through_last_line), 0)) * 100 AS percentage_through_last_line_difficult_target,



  (SUM(de.count_through_last_line_in_build_up) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_through_last_line_in_build_up_per_30_tip,
  (SUM(de.count_targeted_through_last_line_in_build_up) / NULLIF(SUM(de.count_through_last_line_in_build_up), 0)) * 100 AS percentage_through_last_line_in_build_up_targeted,
  (SUM(de.count_received_through_last_line_in_build_up) / NULLIF(SUM(de.count_targeted_through_last_line_in_build_up), 0)) * 100 AS percentage_through_last_line_in_build_up_received,
  (SUM(de.xthreat_through_last_line_in_build_up) / NULLIF(SUM(de.count_through_last_line_in_build_up), 0)) AS avg_xthreat_per_through_last_line_in_build_up,
  (SUM(de.xpass_completion_through_last_line_in_build_up) / NULLIF(SUM(de.count_through_last_line_in_build_up), 0)) AS avg_xpass_completion_through_last_line_in_build_up,
  (SUM(de.count_dangerous_through_last_line_in_build_up) / NULLIF(SUM(de.count_through_last_line_in_build_up), 0)) * 100 AS percentage_through_last_line_in_build_up_dangerous,
  (SUM(de.count_difficult_through_last_line_in_build_up) / NULLIF(SUM(de.count_through_last_line_in_build_up), 0)) * 100 AS percentage_through_last_line_in_build_up_difficult_target,



  (SUM(de.count_through_last_line_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_through_last_line_in_create_per_30_tip,
  (SUM(de.count_targeted_through_last_line_in_create) / NULLIF(SUM(de.count_through_last_line_in_create), 0)) * 100 AS percentage_through_last_line_in_create_targeted,
  (SUM(de.count_received_through_last_line_in_create) / NULLIF(SUM(de.count_targeted_through_last_line_in_create), 0)) * 100 AS percentage_through_last_line_in_create_received,
  (SUM(de.xthreat_through_last_line_in_create) / NULLIF(SUM(de.count_through_last_line_in_create), 0)) AS avg_xthreat_per_through_last_line_in_create,
  (SUM(de.xpass_completion_through_last_line_in_create) / NULLIF(SUM(de.count_through_last_line_in_create), 0)) AS avg_xpass_completion_through_last_line_in_create,
  (SUM(de.count_dangerous_through_last_line_in_create) / NULLIF(SUM(de.count_through_last_line_in_create), 0)) * 100 AS percentage_through_last_line_in_create_dangerous,
  (SUM(de.count_difficult_through_last_line_in_create) / NULLIF(SUM(de.count_through_last_line_in_create), 0)) * 100 AS percentage_through_last_line_in_create_difficult_target,



  (SUM(de.count_through_last_line_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_through_last_line_in_finish_per_30_tip,
  (SUM(de.count_targeted_through_last_line_in_finish) / NULLIF(SUM(de.count_through_last_line_in_finish), 0)) * 100 AS percentage_through_last_line_in_finish_targeted,
  (SUM(de.count_received_through_last_line_in_finish) / NULLIF(SUM(de.count_targeted_through_last_line_in_finish), 0)) * 100 AS percentage_through_last_line_in_finish_received,
  (SUM(de.xthreat_through_last_line_in_finish) / NULLIF(SUM(de.count_through_last_line_in_finish), 0)) AS avg_xthreat_per_through_last_line_in_finish,
  (SUM(de.xpass_completion_through_last_line_in_finish) / NULLIF(SUM(de.count_through_last_line_in_finish), 0)) AS avg_xpass_completion_through_last_line_in_finish,
  (SUM(de.count_dangerous_through_last_line_in_finish) / NULLIF(SUM(de.count_through_last_line_in_finish), 0)) * 100 AS percentage_through_last_line_in_finish_dangerous,
  (SUM(de.count_difficult_through_last_line_in_finish) / NULLIF(SUM(de.count_through_last_line_in_finish), 0)) * 100 AS percentage_through_last_line_in_finish_difficult_target,



  (SUM(de.count_around_last_line) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_around_last_line_per_30_tip,
  (SUM(de.count_targeted_around_last_line) / NULLIF(SUM(de.count_around_last_line), 0)) * 100 AS percentage_around_last_line_targeted,
  (SUM(de.count_received_around_last_line) / NULLIF(SUM(de.count_targeted_around_last_line), 0)) * 100 AS percentage_around_last_line_received,
  (SUM(de.xthreat_around_last_line) / NULLIF(SUM(de.count_around_last_line), 0)) AS avg_xthreat_per_around_last_line,
  (SUM(de.xpass_completion_around_last_line) / NULLIF(SUM(de.count_around_last_line), 0)) AS avg_xpass_completion_around_last_line,
  (SUM(de.count_dangerous_around_last_line) / NULLIF(SUM(de.count_around_last_line), 0)) * 100 AS percentage_around_last_line_dangerous,
  (SUM(de.count_difficult_around_last_line) / NULLIF(SUM(de.count_around_last_line), 0)) * 100 AS percentage_around_last_line_difficult_target,



  (SUM(de.count_around_last_line_in_build_up) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_around_last_line_in_build_up_per_30_tip,
  (SUM(de.count_targeted_around_last_line_in_build_up) / NULLIF(SUM(de.count_around_last_line_in_build_up), 0)) * 100 AS percentage_around_last_line_in_build_up_targeted,
  (SUM(de.count_received_around_last_line_in_build_up) / NULLIF(SUM(de.count_targeted_around_last_line_in_build_up), 0)) * 100 AS percentage_around_last_line_in_build_up_received,
  (SUM(de.xthreat_around_last_line_in_build_up) / NULLIF(SUM(de.count_around_last_line_in_build_up), 0)) AS avg_xthreat_per_around_last_line_in_build_up,
  (SUM(de.xpass_completion_around_last_line_in_build_up) / NULLIF(SUM(de.count_around_last_line_in_build_up), 0)) AS avg_xpass_completion_around_last_line_in_build_up,
  (SUM(de.count_dangerous_around_last_line_in_build_up) / NULLIF(SUM(de.count_around_last_line_in_build_up), 0)) * 100 AS percentage_around_last_line_in_build_up_dangerous,
  (SUM(de.count_difficult_around_last_line_in_build_up) / NULLIF(SUM(de.count_around_last_line_in_build_up), 0)) * 100 AS percentage_around_last_line_in_build_up_difficult_target,



  (SUM(de.count_around_last_line_in_create) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_around_last_line_in_create_per_30_tip,
  (SUM(de.count_targeted_around_last_line_in_create) / NULLIF(SUM(de.count_around_last_line_in_create), 0)) * 100 AS percentage_around_last_line_in_create_targeted,
  (SUM(de.count_received_around_last_line_in_create) / NULLIF(SUM(de.count_targeted_around_last_line_in_create), 0)) * 100 AS percentage_around_last_line_in_create_received,
  (SUM(de.xthreat_around_last_line_in_create) / NULLIF(SUM(de.count_around_last_line_in_create), 0)) AS avg_xthreat_per_around_last_line_in_create,
  (SUM(de.xpass_completion_around_last_line_in_create) / NULLIF(SUM(de.count_around_last_line_in_create), 0)) AS avg_xpass_completion_around_last_line_in_create,
  (SUM(de.count_dangerous_around_last_line_in_create) / NULLIF(SUM(de.count_around_last_line_in_create), 0)) * 100 AS percentage_around_last_line_in_create_dangerous,
  (SUM(de.count_difficult_around_last_line_in_create) / NULLIF(SUM(de.count_around_last_line_in_create), 0)) * 100 AS percentage_around_last_line_in_create_difficult_target,



  (SUM(de.count_around_last_line_in_finish) / NULLIF(SUM(phys.minutes_full_tip), 0)) * 30 AS count_around_last_line_in_finish_per_30_tip,
  (SUM(de.count_targeted_around_last_line_in_finish) / NULLIF(SUM(de.count_around_last_line_in_finish), 0)) * 100 AS percentage_around_last_line_in_finish_targeted,
  (SUM(de.count_received_around_last_line_in_finish) / NULLIF(SUM(de.count_targeted_around_last_line_in_finish), 0)) * 100 AS percentage_around_last_line_in_finish_received,
  (SUM(de.xthreat_around_last_line_in_finish) / NULLIF(SUM(de.count_around_last_line_in_finish), 0)) AS avg_xthreat_per_around_last_line_in_finish,
  (SUM(de.xpass_completion_around_last_line_in_finish) / NULLIF(SUM(de.count_around_last_line_in_finish), 0)) AS avg_xpass_completion_around_last_line_in_finish,
  (SUM(de.count_dangerous_around_last_line_in_finish) / NULLIF(SUM(de.count_around_last_line_in_finish), 0)) * 100 AS percentage_around_last_line_in_finish_dangerous,
  (SUM(de.count_difficult_around_last_line_in_finish) / NULLIF(SUM(de.count_around_last_line_in_finish), 0)) * 100 AS percentage_around_last_line_in_finish_difficult_target

FROM 
  ${ref("dynamic_events_ip", "line_breaking_options")} AS de
JOIN
  ${ref("physical_data", "physical_data")}  AS phys
ON
  de.player_id = phys.player_id
  AND de.match_id = phys.match_id
JOIN
  ${ref("metadata", "players")} AS players
ON
  de.player_id = players.id
JOIN
  ${ref("metadata", "teams")} AS teams
ON
  phys.team_id = CAST(teams.id AS INT)
JOIN
  ${ref("metadata", "match_metadata")} AS match 
ON
  de.match_id = match.match_id
JOIN
  ${ref("metadata", "competition_editions")} AS ce
ON
   ce.id = phys.competition_edition_id
WHERE
  phys.minutes_full_all >= 60
GROUP BY
  de.player_id,
  phys.team_id,
  phys.competition_edition_id,
  competition_edition_name,
  phys.competition_id,
  phys.competition_name,
  phys.season_id,
  phys.season_name,
  phys.position_group,
  players.first_name,
  players.last_name,
  players.short_name,
  teams.name
