  (SUM(de.count_targeted_around_first_line_create) / NULLIF(SUM(de.count_around_first_line_create), 0)) * 100 AS percentage_around_first_line_create_targeted,
  (SUM(de.count_received_around_first_line_create) / NULLIF(SUM(de.count_targeted_around_first_line_create), 0)) * 100 AS percentage_around_first_line_create_received,
  (SUM(de.xthreat_around_first_line_create) / NULLIF(SUM(de.count_around_first_line_create), 0)) AS avg_xthreat_per_around_first_line_create,
  (SUM(de.xpass_completion_around_first_line_create) / NULLIF(SUM(de.count_around_first_line_create), 0)) AS avg_xpass_completion_around_first_line_create,
  (SUM(de.count_dangerous_around_first_line_create) / NULLIF(SUM(de.count_around_first_line_create), 0)) * 100 AS percentage_around_first_line_create_dangerous,
  (SUM(de.count_difficult_around_first_line_create) / NULLIF(SUM(de.count_around_first_line_create), 0)) * 100 AS percentage_around_first_line_create_difficult_target,



