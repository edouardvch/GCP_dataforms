config {
    type: "table",
    schema: "physical_data",
    name: "physical_data",
    description: "",
    bigquery: {
        clusterBy: ["match_id", "player_id", "competition_edition_id"]
    },
    assertions:{
        nonNull: ["match_id", "player_id", "competition_id", "competition_edition_id", "season_id"]
    }
}

