config {
    type: "table",
    schema: "physical_data",
    name: "player_group_physical",
    description: "",
    bigquery: {
        clusterBy: ["player_id", "competition_id", "competition_edition_id", "season_id"]
    },
    assertions:{
        nonNull: ["player_id", "competition_id", "competition_edition_id", "season_id"]
    }
}

SELECT 
    player_id,
    player_name,
    player_short_name,
    player_birthdate,
    team_id,
    team_name,
    competition_id,
    competition_name,
    competition_edition_id,
    season_id,
    season_name,
    position_group,
    COUNT(*) AS count_match,
    AVG(minutes_full_all) AS minutes_full_all,
    AVG(minutes_full_tip) AS minutes_full_tip,
    AVG(minutes_full_otip) AS minutes_full_otip,
    AVG(minutes_h1_all) AS minutes_h1_all,
    AVG(minutes_h1_tip) AS minutes_h1_tip,
    AVG(minutes_h1_otip) AS minutes_h1_otip,
    AVG(minutes_h2_all) AS minutes_h2_all,
    AVG(minutes_h2_tip) AS minutes_h2_tip,
    AVG(minutes_h2_otip) AS minutes_h2_otip,
    AVG(total_distance_full_all) AS total_distance_full_all,
    AVG(total_metersperminute_full_all) AS total_metersperminute_full_all,
    AVG(running_distance_full_all) AS running_distance_full_all,
    AVG(hsr_distance_full_all) AS hsr_distance_full_all,
    AVG(hsr_count_full_all) AS hsr_count_full_all,
    AVG(sprint_distance_full_all) AS sprint_distance_full_all,
    AVG(sprint_count_full_all) AS sprint_count_full_all,
    AVG(hi_distance_full_all) AS hi_distance_full_all,
    AVG(hi_count_full_all) AS hi_count_full_all,
    AVG(medaccel_count_full_all) AS medaccel_count_full_all,
    AVG(highaccel_count_full_all) AS highaccel_count_full_all,
    AVG(meddecel_count_full_all) AS meddecel_count_full_all,
    AVG(highdecel_count_full_all) AS highdecel_count_full_all,
    AVG(explacceltohsr_count_full_all) AS explacceltohsr_count_full_all,
    AVG(timetohsr) AS timetohsr,
    AVG(explacceltosprint_count_full_all) AS explacceltosprint_count_full_all,
    AVG(timetosprint) AS timetosprint,
    AVG(psv99) AS psv99,
    AVG(cod_count_full_all) AS cod_count_full_all,
    AVG(timetohsrpostcod) AS timetohsr_post_cod,
    AVG(timetosprintpostcod) AS timetosprint_post_cod,
    AVG(timeto505around90) AS timeto505around90,
    AVG(timeto505around180) AS timeto505around180,
    

    AVG(total_distance_full_tip) AS total_distance_full_tip,
    AVG(total_metersperminute_full_tip) AS total_metersperminute_full_tip,
    AVG(running_distance_full_tip) AS running_distance_full_tip,
    AVG(hsr_distance_full_tip) AS hsr_distance_full_tip,
    AVG(hsr_count_full_tip) AS hsr_count_full_tip,
    AVG(sprint_distance_full_tip) AS sprint_distance_full_tip,
    AVG(sprint_count_full_tip) AS sprint_count_full_tip,
    AVG(hi_distance_full_tip) AS hi_distance_full_tip,
    AVG(hi_count_full_tip) AS hi_count_full_tip,
    AVG(medaccel_count_full_tip) AS medaccel_count_full_tip,
    AVG(highaccel_count_full_tip) AS highaccel_count_full_tip,
    AVG(meddecel_count_full_tip) AS meddecel_count_full_tip,
    AVG(highdecel_count_full_tip) AS highdecel_count_full_tip,
    AVG(explacceltohsr_count_full_tip) AS explacceltohsr_count_full_tip,
    AVG(explacceltosprint_count_full_tip) AS explacceltosprint_count_full_tip,
    AVG(cod_count_full_tip) AS cod_count_full_tip,

    AVG(total_distance_full_otip) AS total_distance_full_otip,
    AVG(total_metersperminute_full_otip) AS total_metersperminute_full_otip,
    AVG(running_distance_full_otip) AS running_distance_full_otip,
    AVG(hsr_distance_full_otip) AS hsr_distance_full_otip,
    AVG(hsr_count_full_otip) AS hsr_count_full_otip,
    AVG(sprint_distance_full_otip) AS sprint_distance_full_otip,
    AVG(sprint_count_full_otip) AS sprint_count_full_otip,
    AVG(hi_distance_full_otip) AS hi_distance_full_otip,
    AVG(hi_count_full_otip) AS hi_count_full_otip,
    AVG(medaccel_count_full_otip) AS medaccel_count_full_otip,
    AVG(highaccel_count_full_otip) AS highaccel_count_full_otip,
    AVG(meddecel_count_full_otip) AS meddecel_count_full_otip,
    AVG(highdecel_count_full_otip) AS highdecel_count_full_otip,
    AVG(explacceltohsr_count_full_otip) AS explacceltohsr_count_full_otip,
    AVG(explacceltosprint_count_full_otip) AS explacceltosprint_count_full_otip,
    AVG(cod_count_full_otip) AS cod_count_full_otip,

    AVG(total_distance_h1_all) AS total_distance_h1_all,
    AVG(total_metersperminute_h1_all) AS total_metersperminute_h1_all,
    AVG(running_distance_h1_all) AS running_distance_h1_all,
    AVG(hsr_distance_h1_all) AS hsr_distance_h1_all,
    AVG(hsr_count_h1_all) AS hsr_count_h1_all,
    AVG(sprint_distance_h1_all) AS sprint_distance_h1_all,
    AVG(sprint_count_h1_all) AS sprint_count_h1_all,
    AVG(hi_distance_h1_all) AS hi_distance_h1_all,
    AVG(hi_count_h1_all) AS hi_count_h1_all,
    AVG(medaccel_count_h1_all) AS medaccel_count_h1_all,
    AVG(highaccel_count_h1_all) AS highaccel_count_h1_all,
    AVG(meddecel_count_h1_all) AS meddecel_count_h1_all,
    AVG(highdecel_count_h1_all) AS highdecel_count_h1_all,
    AVG(cod_count_h1_all) AS cod_count_h1_all,
    AVG(total_distance_h1_tip) AS total_distance_h1_tip,
    AVG(total_metersperminute_h1_tip) AS total_metersperminute_h1_tip,
    AVG(running_distance_h1_tip) AS running_distance_h1_tip,
    AVG(hsr_distance_h1_tip) AS hsr_distance_h1_tip,
    AVG(hsr_count_h1_tip) AS hsr_count_h1_tip,
    AVG(sprint_distance_h1_tip) AS sprint_distance_h1_tip,
    AVG(sprint_count_h1_tip) AS sprint_count_h1_tip,
    AVG(hi_distance_h1_tip) AS hi_distance_h1_tip,
    AVG(hi_count_h1_tip) AS hi_count_h1_tip,
    AVG(medaccel_count_h1_tip) AS medaccel_count_h1_tip,
    AVG(highaccel_count_h1_tip) AS highaccel_count_h1_tip,
    AVG(meddecel_count_h1_tip) AS meddecel_count_h1_tip,
    AVG(highdecel_count_h1_tip) AS highdecel_count_h1_tip,
    AVG(cod_count_h1_tip) AS cod_count_h1_tip,
    AVG(total_distance_h1_otip) AS total_distance_h1_otip,
    AVG(total_metersperminute_h1_otip) AS total_metersperminute_h1_otip,
    AVG(running_distance_h1_otip) AS running_distance_h1_otip,
    AVG(hsr_distance_h1_otip) AS hsr_distance_h1_otip,
    AVG(hsr_count_h1_otip) AS hsr_count_h1_otip,
    AVG(sprint_distance_h1_otip) AS sprint_distance_h1_otip,
    AVG(sprint_count_h1_otip) AS sprint_count_h1_otip,
    AVG(hi_distance_h1_otip) AS hi_distance_h1_otip,
    AVG(hi_count_h1_otip) AS hi_count_h1_otip,
    AVG(medaccel_count_h1_otip) AS medaccel_count_h1_otip,
    AVG(highaccel_count_h1_otip) AS highaccel_count_h1_otip,
    AVG(meddecel_count_h1_otip) AS meddecel_count_h1_otip,
    AVG(highdecel_count_h1_otip) AS highdecel_count_h1_otip,
    AVG(cod_count_h1_otip) AS cod_count_h1_otip,
    AVG(total_distance_h2_all) AS total_distance_h2_all,
    AVG(total_metersperminute_h2_all) AS total_metersperminute_h2_all,
    AVG(running_distance_h2_all) AS running_distance_h2_all,
    AVG(hsr_distance_h2_all) AS hsr_distance_h2_all,
    AVG(hsr_count_h2_all) AS hsr_count_h2_all,
    AVG(sprint_distance_h2_all) AS sprint_distance_h2_all,
    AVG(sprint_count_h2_all) AS sprint_count_h2_all,
    AVG(hi_distance_h2_all) AS hi_distance_h2_all,
    AVG(hi_count_h2_all) AS hi_count_h2_all,
    AVG(medaccel_count_h2_all) AS medaccel_count_h2_all,
    AVG(highaccel_count_h2_all) AS highaccel_count_h2_all,
    AVG(meddecel_count_h2_all) AS meddecel_count_h2_all,
    AVG(highdecel_count_h2_all) AS highdecel_count_h2_all,
    AVG(cod_count_h2_all) AS cod_count_h2_all,
    AVG(total_distance_h2_tip) AS total_distance_h2_tip,
    AVG(total_metersperminute_h2_tip) AS total_metersperminute_h2_tip,
    AVG(running_distance_h2_tip) AS running_distance_h2_tip,
    AVG(hsr_distance_h2_tip) AS hsr_distance_h2_tip,
    AVG(hsr_count_h2_tip) AS hsr_count_h2_tip,
    AVG(sprint_distance_h2_tip) AS sprint_distance_h2_tip,
    AVG(sprint_count_h2_tip) AS sprint_count_h2_tip,
    AVG(hi_distance_h2_tip) AS hi_distance_h2_tip,
    AVG(hi_count_h2_tip) AS hi_count_h2_tip,
    AVG(medaccel_count_h2_tip) AS medaccel_count_h2_tip,
    AVG(highaccel_count_h2_tip) AS highaccel_count_h2_tip,
    AVG(meddecel_count_h2_tip) AS meddecel_count_h2_tip,
    AVG(highdecel_count_h2_tip) AS highdecel_count_h2_tip,
    AVG(cod_count_h2_tip) AS cod_count_h2_tip,
    AVG(total_distance_h2_otip) AS total_distance_h2_otip,
    AVG(total_metersperminute_h2_otip) AS total_metersperminute_h2_otip,
    AVG(running_distance_h2_otip) AS running_distance_h2_otip,
    AVG(hsr_distance_h2_otip) AS hsr_distance_h2_otip,
    AVG(hsr_count_h2_otip) AS hsr_count_h2_otip,
    AVG(sprint_distance_h2_otip) AS sprint_distance_h2_otip,
    AVG(sprint_count_h2_otip) AS sprint_count_h2_otip,
    AVG(hi_distance_h2_otip) AS hi_distance_h2_otip,
    AVG(hi_count_h2_otip) AS hi_count_h2_otip,
    AVG(medaccel_count_h2_otip) AS medaccel_count_h2_otip,
    AVG(highaccel_count_h2_otip) AS highaccel_count_h2_otip,
    AVG(meddecel_count_h2_otip) AS meddecel_count_h2_otip,
    AVG(highdecel_count_h2_otip) AS highdecel_count_h2_otip,
    AVG(cod_count_h2_otip) AS cod_count_h2_otip,
 
FROM 
    ${ref("physical_data", "physical_data")}
WHERE
  minutes_full_all >= 60
  AND physical_check_passed = True
GROUP BY 
    player_id,
    player_name,
    player_short_name,
    player_birthdate,
    team_id,
    team_name,
    competition_id,
    competition_name,
    competition_edition_id,
    season_id,
    season_name,
    position_group