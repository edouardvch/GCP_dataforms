config {
    type: "table",
    schema: "dynamic_events_ip",
    name: "possessions",
    description: "Dynamic events in possession: possessions",
    bigquery: {
        clusterBy: ["match_id", "player_id"]
    },
    assertions:{
        nonNull: ["match_id", "player_id"]
    }
}

SELECT 
  match_id,
  player_id,
  player_name,
  count_all_possessions,
  count_one_touch_passes_all_possessions,
  quick_passes_all_possessions,
  received_in_tight_space_all_possessions,
  received_in_open_space_all_possessions,
  _8m_carry_all_possessions AS `8m_carry_all_possessions`,
  _8m_carry_at_speed_all_possessions AS `8m_carry_at_speed_all_possessions`,
  forward_momentum_all_possessions,
  count_possessions_in_build_up,
  count_one_touch_passes_possessions_in_build_up,
  quick_passes_possessions_in_build_up,
  received_in_tight_space_possessions_in_build_up,
  received_in_open_space_possessions_in_build_up,
  _8m_carry_possessions_in_build_up AS `8m_carry_possessions_in_build_up`,
  _8m_carry_at_speed_possessions_in_build_up AS `8m_carry_at_speed_possessions_in_build_up`,
  forward_momentum_possessions_in_build_up,
  count_possessions_in_create,
  count_one_touch_passes_possessions_in_create,
  quick_passes_possessions_in_create,
  received_in_tight_space_possessions_in_create,
  received_in_open_space_possessions_in_create,
  _8m_carry_possessions_in_create AS `8m_carry_possessions_in_create`,
  _8m_carry_at_speed_possessions_in_create AS `8m_carry_at_speed_possessions_in_create`,
  forward_momentum_possessions_in_create,
  count_possessions_in_finish,
  count_one_touch_passes_possessions_in_finish,
  quick_passes_possessions_in_finish,
  received_in_tight_space_possessions_in_finish,
  received_in_open_space_possessions_in_finish,
  _8m_carry_possessions_in_finish AS `8m_carry_possessions_in_finish`,
  _8m_carry_at_speed_possessions_in_finish AS `8m_carry_at_speed_possessions_in_finish`,
  forward_momentum_possessions_in_finish,
  count_possessions_in_transition,
  count_one_touch_passes_possessions_in_transition,
  quick_passes_possessions_in_transition,
  received_in_tight_space_possessions_in_transition,
  received_in_open_space_possessions_in_transition,
  _8m_carry_possessions_in_transition AS `8m_carry_possessions_in_transition`,
  _8m_carry_at_speed_possessions_in_transition AS `8m_carry_at_speed_possessions_in_transition`,
  forward_momentum_possessions_in_transition,
  count_possession_retentions,
  count_one_touch_passes_possession_retentions,
  quick_passes_possession_retentions,
  received_in_tight_space_possession_retentions,
  received_in_open_space_possession_retentions,
  _8m_carry_possession_retentions AS `8m_carry_possession_retentions`,
  _8m_carry_at_speed_possession_retentions AS `8m_carry_at_speed_possession_retentions`,
  forward_momentum_possession_retentions
FROM ${ref("skillcorner_external_data", "possessions")}