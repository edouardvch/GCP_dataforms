config {
    type: "table",
    schema: "metadata",
    name: "core_metadata",
    description: "Metadata from match, player_performances, teams, competition_editions, and so on",
    bigquery: {
        clusterBy: ["match_id", "competition_edition_id", "player_id", "team_id"]
    },
    uniqueKey:["match_id", "competition_edition_id", "player_id", "team_id"],
    assertions:{
        uniqueKey: ["match_id", "competition_edition_id", "player_id", "team_id"],
        nonNull: ["match_id", "competition_edition_id", "player_id", "team_id"]
    }
}

WITH mm_ce AS (
  SELECT
    mm.match_id,
    mm.competition_edition_id,
    mm.competition_edition_name,
    ce.competition_id,
    ce.competition_name,
    CASE
      WHEN ce.competition_id IN (1, 3, 4, 5, 6, 12, 16, 17, 18, 25, 26, 27, 28, 29, 30, 31, 40, 41, 42, 43, 47, 57, 58, 59, 60, 61, 64, 65, 68, 69, 70, 77, 78, 79, 80, 82, 86, 87, 88, 89, 90, 92, 93, 94, 95, 96, 97, 98, 100, 101, 102, 103, 104, 105, 106, 113, 114, 116, 119, 120, 121, 122, 124, 126, 127, 132, 133, 135, 136, 138, 139, 140, 142, 145, 146, 151, 152, 155, 156, 157, 158, 162, 165, 167, 168, 170, 172, 173, 174, 190, 191, 194, 203, 204, 205, 207, 208, 211, 218, 222, 223, 224, 227, 228, 229, 230, 231, 235, 239, 240, 241, 275, 309, 310, 312, 314, 315, 316, 319, 320, 321, 323, 329, 332, 333, 336, 338, 340, 341, 348, 376, 379, 406, 407, 408, 409, 410, 412, 413, 439, 444, 446, 447, 449, 450, 451, 452, 453, 454, 455, 456, 457, 458, 459, 465, 466, 467, 468, 469, 474, 475, 476, 477, 478, 479, 482, 484, 486, 488, 489, 490, 494, 497, 498, 499, 500, 501, 502, 505, 506, 507, 508, 509, 510, 511, 512, 513, 517, 518, 519, 520, 523, 524, 525, 526, 528, 529, 530, 531, 532, 533, 538, 539, 540, 541, 542, 543, 545, 547, 571, 579, 583, 584, 587, 589, 590, 591, 592, 593, 594, 595, 596, 597, 600, 601, 603, 604, 605, 606, 608, 610, 611, 615, 617)
        THEN 'Domestic League'
      WHEN ce.competition_id IN (7, 8, 13, 19, 44, 52, 53, 54, 66, 74, 76, 84, 91, 107, 112, 134, 143, 154, 169, 209, 210, 274, 307, 308, 311, 318, 328, 335, 377, 440, 442, 480, 492, 503, 537, 570, 572, 573, 574, 576, 578, 580, 582, 585, 599, 613, 614, 616)
        THEN 'Domestic Cup'
      WHEN ce.competition_id IN (9, 10, 108, 109, 110, 131, 141, 147, 148, 159, 317, 330, 344, 346, 378, 445, 448, 516, 522, 534, 535, 536, 567, 575, 577, 612)
        THEN 'International Club'
      WHEN ce.competition_id IN (0, 2, 15, 20, 21, 32, 33, 34, 35, 36, 37, 39, 48, 49, 51, 55, 62, 63, 85, 115, 117, 118, 123, 128, 130, 137, 144, 149, 150, 153, 160, 161, 163, 164, 166, 176, 177, 178, 179, 181, 182, 183, 184, 185, 186, 187, 188, 189, 192, 193, 195, 197, 199, 200, 201, 202, 212, 213, 214, 215, 216, 217, 219, 220, 221, 225, 226, 232, 233, 234, 237, 238, 327, 331, 337, 342, 343, 345, 347, 373, 374, 375, 443, 460, 461, 462, 463, 485, 491, 493, 495, 496, 504, 515, 521, 588, 602, 607, 609)
        THEN 'International Nation'
      ELSE 'Other'
    END AS competition_type,
    ce.season_id,
    ce.season_name,
    ce.competition_gender,
    ce.competition_area,
    ce.competition_age_group,
    ce.season_start_year,
    season_end_year
    FROM ${ref("metadata", "match_metadata")} AS mm
    JOIN ${ref("competition_editions")} AS ce
    ON ce.id = mm.competition_edition_id
),

mmce_pp AS (
  SELECT
  mm_ce.*,
  pp.player_id,
  pp.wyscout_id AS player_wyscout_id,
  pp.team_id,
  pp.team_player_id,
  pp.number,
  CONCAT(pp.first_name, ' ',pp.last_name) AS player_name,
  pp.short_name,
  pp.birthday,
  pp.gender,
  pp.trackable_object,
  pp.start_time,
  pp.end_time,
  pp.yellow_card,
  pp.red_card,
  pp.injured,
  pp.goal,
  pp.own_goal,
  pp.player_role_id,
  pp.player_role_position_group,
  pp.player_role_name,
  pp.player_role_acronym,
  pp.playing_time_total_minutes_tip,
  pp.playing_time_total_minutes_otip,
  pp.playing_time_total_start_frame,
  pp.playing_time_total_end_frame,
  pp.playing_time_total_minutes_played,
  pp.playing_time_total_minutes_played_regular_time,
  pp.match_period_1_minutes_tip,
  pp.match_period_1_minutes_otip,
  pp.match_period_1_start_frame,
  pp.match_period_1_end_frame,
  pp.match_period_1_minutes_played,
  pp.match_period_2_minutes_tip,
  pp.match_period_2_minutes_otip,
  pp.match_period_2_start_frame,
  pp.match_period_2_end_frame,
  pp.match_period_2_minutes_played,
  pp.match_period_3_minutes_tip,
  pp.match_period_3_minutes_otip,
  pp.match_period_3_start_frame,
  pp.match_period_3_end_frame,
  pp.match_period_3_minutes_played,
  pp.match_period_4_minutes_tip,
  pp.match_period_4_minutes_otip,
  pp.match_period_4_start_frame,
  pp.match_period_4_end_frame,
  pp.match_period_4_minutes_played
  FROM ${ref("player_performances")} AS pp
  JOIN mm_ce ON mm_ce.match_id = pp.match_id
  ),

mmcepp_t AS (
  SELECT 
  mmce_pp.*,
  t.name as team_name,
  t.coach AS coach_name,
  t.stadium_id,
  t.stadium_name,
  t.stadium,
  t.stadium_city,
  t.stadium_capacity
  FROM ${ref("teams")} as t
  JOIN mmce_pp
  ON mmce_pp.team_id = CAST(t.id AS INT64)),

core_metadata AS (
  SELECT
  mmcepp_t.*,
  dc.status,
  dc.physical_last_modified,
  dc.physical_v3_last_modified,
  dc.tracking_last_modified,
  dc.tracking_extra_last_modified,
  dc.tracking_extra_players_quality_index,
  dc.tracking_extra_ball_quality_index,
  dc.tracking_extra_v3_last_modified,
  dc.tracking_extra_v3_players_quality_index,
  dc.tracking_extra_v3_ball_quality_index,
  dc.in_possession_off_ball_runs_last_modified,
  dc.in_possession_passes_last_modified,
  dc.in_possession_dealing_with_pressure_last_modified,
  dc.dynamic_events_check,
  dc.dynamic_events_last_modified,
  dc.video_feed_type,
  dc.period_frame_provider,
  dc.lineup_provider,
  dc.data_check,
  dc.video_check,
  dc.synchronized_with_events,
  dc.frame_selection_version,
  dc.physical_v3_status
  FROM mmcepp_t
  LEFT JOIN ${ref("data_collection")} AS dc
  ON mmcepp_t.match_id = dc.match_id)

SELECT * FROM core_metadata