UPDATE 
    ${ref("physical_data", "physical_data")} AS pd
SET 
    pd.player_name = (
        SELECT CONCAT(p.first_name, ' ', p.last_name)
        FROM ${ref("metadata", "players")} AS p
        WHERE pd.player_id = p.id
    ),
    pd.player_short_name = (
        SELECT p.short_name
        FROM ${ref("metadata", "players")} AS p
        WHERE pd.player_id = p.id
    )
WHERE 
    EXISTS (
        SELECT 1 
        FROM ${ref("metadata", "players")} AS p
        WHERE pd.player_id = p.id
    );
