config {
    type: "incremental",
    schema: "historical_data",
    name: "historical_dynamic_events",
    bigquery: {
        clusterBy: ["event_id", "event_type", "event_subtype"]
    },
    uniqueKey:["event_id"],
    assertions:{
        nonNull: ["event_id"]
    },
    tags : ["bi_weekly_incremental"]
}

SELECT
    de.*,
    ce.season_name
FROM ${ref("skillcorner_external_data", "dynamic_events")} AS de
JOIN (
    SELECT match_id, competition_edition_id
    FROM ${ref("skillcorner_external_data", "match_metadata")}
    QUALIFY ROW_NUMBER() OVER (PARTITION BY match_id ORDER BY match_id) = 1
) AS mm
    ON mm.match_id = de.match_id
JOIN ${ref("skillcorner_external_data", "competition_editions")} AS ce
    ON mm.competition_edition_id = ce.id
WHERE ce.season_name IN ('2021', '2021/2022', '2022', '2022/2023', '2023', '2023/2024',  '2024/2025', '2025', '2024', '2025/2026', '2026')

${when(incremental(), `AND ce.season_name IN ('2025/2026', '2026')`)}