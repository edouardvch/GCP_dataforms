config {
    type: "table",
    schema: "csm_team_sandbox",
    name: "freeze_frames_avg_positions_diego",
    description: "",
    assertions:{
        nonNull: ["competition_edition_id", "match_id", "team_id", "player_id"]
    }
}

SELECT 
    t2.competition_edition_id,
    t1.* 
FROM ${ref("external_tables", "v2_freeze_frame_avg_positions")} t1
LEFT JOIN ${ref("metadata", "core_metadata")} t2
ON t1.match_id = t2.match_id