config {
    type: "table",
    schema: "metadata",
    name: "competition_editions",
    description: "Competition editions infos",
    bigquery: {
        clusterBy: ["competition_id", "season_id"]
    },
    uniqueKey:["id"],
    assertions:{
        uniqueKey: ["id"],
        nonNull: ["id"]
    }
}

SELECT 
*,
CASE
  WHEN competition_id IN (1, 3, 4, 5, 6, 12, 16, 17, 18, 25, 26, 27, 28, 29, 30, 31, 40, 41, 42, 43, 47, 57, 58, 59, 60, 61, 64, 65, 68, 69, 70, 77, 78, 79, 80, 82, 86, 87, 88, 89, 90, 92, 93, 94, 95, 96, 97, 98, 100, 101, 102, 103, 104, 105, 106, 113, 114, 116, 119, 120, 121, 122, 124, 126, 127, 132, 133, 135, 136, 138, 139, 140, 142, 145, 146, 151, 152, 155, 156, 157, 158, 162, 165, 167, 168, 170, 172, 173, 174, 190, 191, 194, 203, 204, 205, 207, 208, 211, 218, 222, 223, 224, 227, 228, 229, 230, 231, 235, 239, 240, 241, 275, 309, 310, 312, 314, 315, 316, 319, 320, 321, 323, 329, 332, 333, 336, 338, 340, 341, 348, 376, 379, 406, 407, 408, 409, 410, 412, 413, 439, 444, 446, 447, 449, 450, 451, 452, 453, 454, 455, 456, 457, 458, 459, 465, 466, 467, 468, 469, 474, 475, 476, 477, 478, 479, 482, 484, 486, 488, 489, 490, 494, 497, 498, 499, 500, 501, 502, 505, 506, 507, 508, 509, 510, 511, 512, 513, 517, 518, 519, 520, 523, 524, 525, 526, 528, 529, 530, 531, 532, 533, 538, 539, 540, 541, 542, 543, 545, 547, 571, 579, 583, 584, 587, 589, 590, 591, 592, 593, 594, 595, 596, 597, 600, 601, 603, 604, 605, 606, 608, 610, 611, 615, 617)
    THEN 'Domestic League'
  WHEN competition_id IN (7, 8, 13, 19, 44, 52, 53, 54, 66, 74, 76, 84, 91, 107, 112, 134, 143, 154, 169, 209, 210, 274, 307, 308, 311, 318, 328, 335, 377, 440, 442, 480, 492, 503, 537, 570, 572, 573, 574, 576, 578, 580, 582, 585, 599, 613, 614, 616)
    THEN 'Domestic Cup'
  WHEN competition_id IN (9, 10, 108, 109, 110, 131, 141, 147, 148, 159, 317, 330, 344, 346, 378, 445, 448, 516, 522, 534, 535, 536, 567, 575, 577, 612)
    THEN 'International Club'
  WHEN competition_id IN (0, 2, 15, 20, 21, 32, 33, 34, 35, 36, 37, 39, 48, 49, 51, 55, 62, 63, 85, 115, 117, 118, 123, 128, 130, 137, 144, 149, 150, 153, 160, 161, 163, 164, 166, 176, 177, 178, 179, 181, 182, 183, 184, 185, 186, 187, 188, 189, 192, 193, 195, 197, 199, 200, 201, 202, 212, 213, 214, 215, 216, 217, 219, 220, 221, 225, 226, 232, 233, 234, 237, 238, 327, 331, 337, 342, 343, 345, 347, 373, 374, 375, 443, 460, 461, 462, 463, 485, 491, 493, 495, 496, 504, 515, 521, 588, 602, 607, 609)
    THEN 'International Nation'
    ELSE 'Other'
  END AS competition_type,
COALESCE(CONCAT(competition_area, '-', competition_name)) AS code
FROM ${ref("external_tables", "competition_editions")}